def Laws.escaping_loses_nothing(s):
  match s:
    case SNil{}:
      {==}
    case SCon{+c, +t}:
      %Laws.escaping_loses_nothing(t) : {H.unescape(H.esc_as(H.special(c), c, H.esc(t, ""))) == SCon{c, _} : String}
      unesc_char(c, H.esc(t, ""))

def Laws.unescapes():
  {==}

# Lists
# =====

law li_nodes_are_li:
  for items: List<&2, H.Li>
  {Laws.all_li(H.li_nodes(items)) == True{} : Bool}

def li_nodes_are_li(items):
  match items:
    case Nil{}:
      {==}
    case H.Li{attrs, children} <> rest:
      li_nodes_are_li(rest)

def Laws.ul_holds_only_li(attrs, items):
  li_nodes_are_li(items)

def Laws.ol_holds_only_li(attrs, items):
  li_nodes_are_li(items)

# Tables
# ======

law cells_are_cells:
  for cells: List<&2, H.Cell>
  {Laws.all_cells(H.cell_nodes(cells)) == True{} : Bool}

def cells_are_cells(cells):
  match cells:
    case Nil{}:
      {==}
    case H.Th{attrs, children} <> rest:
      cells_are_cells(rest)
    case H.Td{attrs, children} <> rest:
      cells_are_cells(rest)

law rows_are_rows:
  for rows: List<&2, H.Row>
  {Laws.all_rows(H.row_nodes(rows)) == True{} : Bool}

def rows_are_rows(rows):
  match rows:
    case Nil{}:
      {==}
    case H.Tr{attrs, +cells} <> rest:
      %Equal.sym(Bool, Laws.all_cells(H.cell_nodes(cells)), True{}, cells_are_cells(cells)) : {(_ && Laws.all_rows(H.row_nodes(rest))) == True{} : Bool}
      rows_are_rows(rest)

law sections_are_sections:
  for sections: List<&2, H.Section>
  {Laws.all_sections(H.section_nodes(sections)) == True{} : Bool}

def sections_are_sections(sections):
  match sections:
    case Nil{}:
      {==}
    case H.THead{attrs, +rows} <> rest:
      %Equal.sym(Bool, Laws.all_rows(H.row_nodes(rows)), True{}, rows_are_rows(rows)) : {(_ && Laws.all_sections(H.section_nodes(rest))) == True{} : Bool}
      sections_are_sections(rest)
    case H.TBody{attrs, +rows} <> rest:
      %Equal.sym(Bool, Laws.all_rows(H.row_nodes(rows)), True{}, rows_are_rows(rows)) : {(_ && Laws.all_sections(H.section_nodes(rest))) == True{} : Bool}
      sections_are_sections(rest)
    case H.TFoot{attrs, +rows} <> rest:
      %Equal.sym(Bool, Laws.all_rows(H.row_nodes(rows)), True{}, rows_are_rows(rows)) : {(_ && Laws.all_sections(H.section_nodes(rest))) == True{} : Bool}
      sections_are_sections(rest)

def Laws.table_is_well_formed(attrs, sections):
  sections_are_sections(sections)

def Laws.renders_a_table():
  {==}

# Style and script
# ================

def Laws.classifies_guarded_chars():
  {==}

# Guarding one char: what follows is read as after that char.
law guard_as_closes:
  for k: H.Near
  for c: Char
  for b: Bool
  for x: String
  for e: {H.near(c) == k : H.Near}
  {Laws.closes(H.guard_as(k, c, b, x), b) == Laws.closes(x, H.is_lt(k)) : Bool}

def guard_as_closes(k, c, b, x, e):
  match k b:
    case H.LtChar{} True{}:
      %e : {Laws.closes(SCon{c, x}, True{}) == ((True{} && Laws.is_shut(_)) || Laws.closes(x, H.is_lt(_))) : Bool}
      {==}
    case H.LtChar{} False{}:
      %e : {Laws.closes(SCon{c, x}, False{}) == ((False{} && Laws.is_shut(_)) || Laws.closes(x, H.is_lt(_))) : Bool}
      {==}
    case H.Shut{} True{}:
      %e : {Laws.closes(SCon{c, x}, False{}) == ((False{} && Laws.is_shut(_)) || Laws.closes(x, H.is_lt(_))) : Bool}
      {==}
    case H.Shut{} False{}:
      %e : {Laws.closes(SCon{c, x}, False{}) == ((False{} && Laws.is_shut(_)) || Laws.closes(x, H.is_lt(_))) : Bool}
      {==}
    case H.Else{} True{}:
      %e : {Laws.closes(SCon{c, x}, True{}) == ((True{} && Laws.is_shut(_)) || Laws.closes(x, H.is_lt(_))) : Bool}
      {==}
    case H.Else{} False{}:
      %e : {Laws.closes(SCon{c, x}, False{}) == ((False{} && Laws.is_shut(_)) || Laws.closes(x, H.is_lt(_))) : Bool}
      {==}

law guard_closes:
  for s: String
  for b: Bool
  {Laws.closes(H.guard(s, b, ""), b) == False{} : Bool}

def guard_closes(s, b):
  match s:
    case SNil{}:
      {==}
    case SCon{+c, +t}:
      %guard_closes(t, H.is_lt(H.near(c))) : {Laws.closes(H.guard_as(H.near(c), c, b, H.guard(t, H.is_lt(H.near(c)), "")), b) == _ : Bool}
      guard_as_closes(H.near(c), c, b, H.guard(t, H.is_lt(H.near(c)), ""), {==})

def Laws.guarded_text_cannot_close(s):
  guard_closes(s, False{})

law guard_as_app:
  for k: H.Near
  for c: Char
  for b: Bool
  for x: String
  for y: String
  {String.append(H.guard_as(k, c, b, x), y) == H.guard_as(k, c, b, String.append(x, y)) : String}

def guard_as_app(k, c, b, x, y):
  match k b:
    case H.Shut{} True{}:
      {==}
    case H.Shut{} False{}:
      {==}
    case H.LtChar{} _:
      {==}
    case H.Else{} _:
      {==}

law guard_app:
  for s: String
  for b: Bool
  for +tail: String
  {H.guard(s, b, tail) == String.append(H.guard(s, b, ""), tail) : String}

def guard_app(s, b, tail):
  match s:
    case SNil{}:
      {==}
    case SCon{+c, +t}:
      %Equal.sym(String, String.append(H.guard_as(H.near(c), c, b, H.guard(t, H.is_lt(H.near(c)), "")), tail), H.guard_as(H.near(c), c, b, String.append(H.guard(t, H.is_lt(H.near(c)), ""), tail)), guard_as_app(H.near(c), c, b, H.guard(t, H.is_lt(H.near(c)), ""), tail)) : {H.guard_as(H.near(c), c, b, H.guard(t, H.is_lt(H.near(c)), tail)) == _ : String}
      %guard_app(t, H.is_lt(H.near(c)), tail) : {H.guard_as(H.near(c), c, b, H.guard(t, H.is_lt(H.near(c)), tail)) == H.guard_as(H.near(c), c, b, _) : String}
      {==}

def Laws.style_text_is_guarded(s):
  Equal.cong(String, String, x => String.append("<style>", x), H.guard(s, False{}, "</style>"), String.append(H.guard(s, False{}, ""), "</style>"), guard_app(s, False{}, "</style>"))

def Laws.script_text_is_guarded(s):
  Equal.cong(String, String, x => String.append("<script>", x), H.guard(s, False{}, "</script>"), String.append(H.guard(s, False{}, ""), "</script>"), guard_app(s, False{}, "</script>"))

def Laws.renders_style_and_script():
  {==}
